PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLIENT_ORIGIN=http://localhost:5173

# Firebase Cloud Messaging (preferred for Flutter tokens, kind=fcm)
# Paste the full service account JSON as one line (escape quotes if needed)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=blindtigerclub-4894e
PUSH_WEBHOOK_SECRET=
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> — allow that as drain auth too
CRON_SECRET=

# Optional direct APNs (edge function / Live Activity). Prefer FCM path above.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.intime.inTimeBartender
# APNS_PRIVATE_KEY=
# APNS_ENVIRONMENT=sandbox

# Invite-gated app downloads (/download)
APP_IOS_DOWNLOAD_URL=https://testflight.apple.com/join/9yKpM4rz
# Android APK comes from the private Supabase Storage bucket below.
# The universal APK (~90 MB) exceeds the 50 MB free-plan per-file limit, so upload
# the per-ABI splits from `flutter build apk --split-per-abi`. With no object
# pinned, the server serves the first available of:
#   app-arm64-v8a-release.apk -> app-armeabi-v7a-release.apk -> app-x86_64-release.apk -> app-release.apk
APP_ANDROID_STORAGE_BUCKET=app-releases
# APP_ANDROID_STORAGE_OBJECT=app-arm64-v8a-release.apk
# Direct-URL override (e.g. a GitHub Release asset) — skips Supabase Storage entirely.
# APP_ANDROID_DOWNLOAD_URL=

